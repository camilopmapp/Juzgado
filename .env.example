# Copie este archivo a .env.local. Con Supabase local, `npx supabase status -o env` muestra los valores.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# URL pública del sitio (enlaces de invitación y recuperación). Debe coincidir con site_url de Supabase.
SITIO_URL=http://localhost:3000
